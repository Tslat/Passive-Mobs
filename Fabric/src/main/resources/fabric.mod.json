{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
  
    "name": "${mod_display_name}",
    "description": "${mod_description}",
    "authors": [
      "${mod_authors}"
    ],
    "contact": {
      "homepage": "${homepage_url}",
      "sources": "${sources_url}"
    },
  
    "license": "${mod_license}",
    "icon": "logo.png",
  
    "environment": "*",
    "entrypoints": {
      "main": [
        "net.tslat.passivemobs.PassiveMobs"
      ]
    },
    "mixins": [
      "passivemobs.mixins.json"
    ],
  
    "depends": {
      "fabricloader": ">=${fabric_loader_version_range}",
      "minecraft": ">=${minecraft_version}",
      "java": ">=${java_version}"
    }
  }
  
